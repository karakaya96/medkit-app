# Copy this file to `backend/.env.local` and fill in the values.
# The backend and the voice worker read these at startup — restart them
# after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# ── OpenRouter — tek ücretli olmayan LLM yolu ───────────────────────
# Hasta sohbeti, ESI triyaj ve debrief değerlendirmesi buradan geçer.
# Ücretsiz modeller için hesap açıp kredi yüklemeden anahtar alabilirsin:
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Router istemiyorsan belirli bir ücretsiz model seç. Ekim 2026'da
# doğrulanmış :free kimlikleri:
#   openrouter/free                          (sağlıklı ücretsiz modeli seçer)
#   nvidia/nemotron-3-super-120b-a12b:free   (262K bağlam, araç desteği)
#   nvidia/nemotron-3-ultra-550b-a55b:free   (1M bağlam)
#   nvidia/nemotron-3.5-lightning:free       (hızlı, 1M bağlam)
FREE_MODEL=openrouter/free
PATIENT_MODEL=openrouter/free
TRIAGE_MODEL=openrouter/free
GRADER_MODEL=openrouter/free

# ── NVIDIA (isteğe bağlı yedek) ─────────────────────────────────────
# build.nvidia.com ücretsiz kredi verir. LLM_PROVIDER=nvidia yaparsan
# voice worker OpenRouter yerine doğrudan NVIDIA'ya gider.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning
LLM_PROVIDER=openrouter

# ── Debrief değerlendirme ayarları ──────────────────────────────────
# Ücretsiz modeller bazen yavaş yanıtlar; 90 sn makul bir üst sınır.
DEBRIEF_MAX_TOKENS=4096
DEBRIEF_TIMEOUT_SEC=90

# ── Voice worker (yerel, API anahtarı yok) ──────────────────────────
# faster-whisper modeli: tiny | base | small | medium | large-v3
# base hızlıdır; Türkçe doğruluk yetmezse small'a çıkar (daha çok RAM).
WHISPER_MODEL=base

# ── LiveKit — WebRTC transport ──────────────────────────────────────
# Cloud (ücretsiz kota): https://cloud.livekit.io → proje → Settings → Keys
#   LIVEKIT_URL=wss://<proje>.livekit.cloud
# Yerel geliştirme sunucusu (hesap gerekmez):
#   livekit-server --dev --bind 127.0.0.1
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opsiyonel: yönetim (Twirp) URL'i farklıysa; ws:// otomatik http:// olur.
LIVEKIT_API_URL=

# ── Backend koruması ────────────────────────────────────────────────
# Hosted bir dağıtım yok; localhost istekleri otomatik bypass eder.
BACKEND_SHARED_SECRET=

# ── Credential vault demo ───────────────────────────────────────────
# Sadece backend sürecinde kalır; POST /agent/vault/ehr/lookup kullanır.
EHR_API_TOKEN=
