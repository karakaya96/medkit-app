# Copy this file to `backend/.env.local` and fill in the values.
# The backend and the voice worker read these at startup — restart them
# after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# ── LLM sağlayıcıları (ikisi de ücretsiz) ───────────────────────────
# Birincil: NVIDIA NIM (build.nvidia.com). OpenRouter'ın günlük 50 ücretsiz
# istek sınırı yok; aynı Nemotron modelini doğrudan çalıştırır.
# Yedek: OpenRouter :free — NVIDIA hata verirse backend otomatik geçer.
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PATIENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TRIAGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_GRADER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# OpenRouter anahtarı yalnızca yedek yol için gerekir. Günlük ücretsiz limit
# dolduğunda 429 alırsın; NVIDIA birincil olduğu için normal akış etkilenmez.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ekim 2026'da doğrulanmış :free kimlikleri:
#   nvidia/nemotron-3.5-lightning:free       (hızlı, JSON'da güvenilir)
#   nvidia/nemotron-3-ultra-550b-a55b:free   (1M bağlam, daha yavaş)
#   openrouter/free                          (rastgele router — JSON görevlerde
#                                             reasoning modeline düşüp boş/kırık
#                                             yanıt verebilir; varsayılan yapma)
OPENROUTER_GRADER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_PATIENT_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_TRIAGE_MODEL=nvidia/nemotron-3.5-lightning:free

# ── Debrief değerlendirme ayarları ──────────────────────────────────
# 18 kriterli değerlendirme ~1600 token; 90 sn üst sınır.
DEBRIEF_MAX_TOKENS=2500
DEBRIEF_TIMEOUT_SEC=90

# ── Voice worker (yerel, API anahtarı yok) ──────────────────────────
# faster-whisper modeli: tiny | base | small | medium | large-v3
# base hızlıdır; Türkçe doğruluk yetmezse small'a çıkar (daha çok RAM).
WHISPER_MODEL=base

# ── LiveKit — WebRTC transport ──────────────────────────────────────
# Cloud (ücretsiz kota): https://cloud.livekit.io → proje → Settings → Keys
#   LIVEKIT_URL=wss://<proje>.livekit.cloud
# Yerel geliştirme sunucusu (hesap gerekmez):
#   livekit-server --dev --bind 127.0.0.1
#   LIVEKIT_URL=ws://127.0.0.1:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Opsiyonel: yönetim (Twirp) URL'i farklıysa; ws:// otomatik http:// olur.
LIVEKIT_API_URL=

# ── Backend koruması ────────────────────────────────────────────────
# Hosted bir dağıtım yok; localhost istekleri otomatik bypass eder.
BACKEND_SHARED_SECRET=

# ── Credential vault demo ───────────────────────────────────────────
# Sadece backend sürecinde kalır; POST /agent/vault/ehr/lookup kullanır.
EHR_API_TOKEN=
