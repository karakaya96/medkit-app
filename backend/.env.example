# Copy this file to `backend/.env.local` and fill in the values.
# The backend and the voice worker read these at startup — restart them
# after editing.
#
# WARNING: .env.local is gitignored. Never commit API keys.

# ── Anthropic — medkit-attending Managed Agent (debrief grading) ─────
# Server-side only. Never expose this to the browser.
ANTHROPIC_API_KEY=

# Cached IDs for the persistent Managed Agent + Environment.
# First run: leave these blank, start the server, POST /agent/bootstrap,
# then paste the returned `agent_id` / `environment_id` back here and
# restart. Subsequent runs are no-ops.
MEDKIT_AGENT_ID=
MEDKIT_ENV_ID=

# ── OpenRouter / NVIDIA — patient persona + triage + voice LLM ──────
# OpenRouter is the primary provider; NVIDIA is the fallback used by the
# voice worker when LLM_PROVIDER=nvidia.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_PROVIDER=openrouter

# Model overrides (OpenAI-compatible IDs).
PATIENT_MODEL=nvidia/nemotron-3-ultra:free
TRIAGE_MODEL=nvidia/nemotron-3-ultra:free

# ── Voice worker (local, no API key) ────────────────────────────────
# faster-whisper model: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# ── LiveKit Cloud — WebRTC transport ────────────────────────────────
# https://cloud.livekit.io → project → Settings → Keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Backend protection ──────────────────────────────────────────────
# Injected by the Vercel Edge middleware (see middleware.ts). Requests
# from loopback (local `npm run dev`) bypass it automatically.
BACKEND_SHARED_SECRET=

# ── Credential vault demo ───────────────────────────────────────────
# Never leaves the backend process; used by POST /agent/vault/ehr/lookup.
EHR_API_TOKEN=
